{
  "ok": true,
  "project": "Neoveg",
  "thirdPartyRoot": "third_party/",
  "modules": [
    {
      "id": "openfx",
      "name": "OpenFX Core SDK (ofxCore)",
      "repository": "https://github.com/AcademySoftwareFoundation/openfx.git",
      "license": "BSD-3-Clause / Apache-2.0",
      "localDir": "third_party/openfx",
      "gitSynced": false,
      "verifiedFiles": [
        "include/ofxCore.h",
        "include/ofxImageEffect.h"
      ],
      "missingFiles": [],
      "ready": true
    },
    {
      "id": "vst3sdk",
      "name": "Steinberg VST3 Audio Processor SDK",
      "repository": "https://github.com/steinbergmedia/vst3sdk.git",
      "license": "GPL-3.0-or-later",
      "localDir": "third_party/vst3sdk",
      "gitSynced": false,
      "verifiedFiles": [
        "pluginterfaces/vst/ivstaudioprocessor.h"
      ],
      "missingFiles": [],
      "ready": true
    },
    {
      "id": "voukoder",
      "name": "Voukoder Pro Hardware Encoder Connector",
      "repository": "https://github.com/Vouk/voukoder.git",
      "license": "LGPL-2.1-or-later / GPL-2.0",
      "localDir": "third_party/voukoder",
      "gitSynced": false,
      "verifiedFiles": [
        "include/voukoder_bridge.h"
      ],
      "missingFiles": [],
      "ready": true
    },
    {
      "id": "whisper.cpp",
      "name": "Whisper.cpp GGML AI Speech-to-Text",
      "repository": "https://github.com/ggerganov/whisper.cpp.git",
      "license": "MIT",
      "localDir": "third_party/whisper.cpp",
      "gitSynced": false,
      "verifiedFiles": [
        "include/whisper.h"
      ],
      "missingFiles": [],
      "ready": true
    },
    {
      "id": "corridorkey",
      "name": "CorridorKey Green Screen Matte & Despill Engine",
      "repository": "https://github.com/CorridorDigital/CorridorKey.git",
      "license": "MIT",
      "localDir": "third_party/corridorkey",
      "gitSynced": false,
      "verifiedFiles": [
        "corridorkey_manifest.json"
      ],
      "missingFiles": [],
      "ready": true
    }
  ],
  "nativeBuild": {
    "rust_core": {
      "compiled": true,
      "mode": "cargo-release-native",
      "copied_libraries": [
        "runtimes/win-x64/native/neoveg_core.dll",
        "runtimes/linux-x64/native/libneoveg_core.so",
        "runtimes/osx-x64/native/libneoveg_core.dylib",
        "runtimes/osx-arm64/native/libneoveg_core.dylib"
      ]
    },
    "cpp_engine": {
      "compiled": true,
      "mode": "native-x86_64-c-abi-cpp-engine",
      "copied_libraries": [
        "runtimes/win-x64/native/neoveg_cpp_engine.dll",
        "runtimes/linux-x64/native/libneoveg_cpp_engine.so",
        "runtimes/osx-x64/native/libneoveg_cpp_engine.dylib",
        "runtimes/osx-arm64/native/libneoveg_cpp_engine.dylib"
      ],
      "exported_symbols": [
        "neoveg_cpp_compute_pancrop_matrix",
        "neoveg_cpp_free_buffer",
        "neoveg_cpp_ofx_host_enumerate",
        "neoveg_cpp_ofx_process_rgba8",
        "neoveg_cpp_shm_fill_frame",
        "neoveg_cpp_shm_publish_named",
        "neoveg_cpp_verify_directx_runtime",
        "neoveg_cpp_version",
        "neoveg_cpp_voukoder_enumerate_encoders",
        "neoveg_cpp_vst3_host_enumerate",
        "neoveg_cpp_vst3_process_f32",
        "neoveg_cpp_whisper_transcribe_json"
      ]
    }
  },
  "stagedDistPackages": []
}