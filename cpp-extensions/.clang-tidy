# Neoveg C++ static analysis profile (used by scripts/run_qa_suite.ps1 / .sh).
# Explicit list: some clang-tidy distributions (e.g. LLVM-MinGW) enable no checks by default.
Checks: >
  -*,
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*
# Memory-safety and logic bugs found by the static analyzer fail the QA suite (ISO/IEC 27001 FFI safety).
WarningsAsErrors: >
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-unix.Malloc,
  bugprone-use-after-move,
  bugprone-dangling-handle
HeaderFilterRegex: 'cpp-extensions[/\\](src|whisper\.cpp[/\\]src)[/\\].*'
FormatStyle: none
