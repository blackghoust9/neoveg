# syntax=docker/dockerfile:1
#
# Neoveg - Linux test and release image (pure Rust workspace, no .NET / C++ / Python toolchains).
#
# The source tree is NOT copied into the image: docker-compose bind-mounts it at /workspace, so the
# image only holds the Rust toolchain, the native libraries the crates link against and the entry points.
#
#   docker build -f docker/Dockerfile.rust-linux -t neoveg/rust-linux:local docker
#
# `rust:latest` follows the current Debian stable. Pin it for reproducible builds, for example
# `--build-arg RUST_IMAGE=rust:1.99-trixie`. FFmpeg 7.1.x development packages are needed only for the
# optional `ffmpeg` feature (ffmpeg-next 7.1); the default build and the tests do not use them.
ARG RUST_IMAGE=rust:latest
FROM ${RUST_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential pkg-config clang libclang-dev python3 ca-certificates \
        # audio output (cpal) and device enumeration
        libasound2-dev libudev-dev \
        # window system, OpenGL and Vulkan (egui / eframe / wgpu)
        libgl1-mesa-dev libx11-dev libxcursor-dev libxrandr-dev libxi-dev libxkbcommon-dev \
        libxkbcommon-x11-dev libwayland-dev libvulkan-dev \
        # software Vulkan so wgpu has an adapter inside the container
        libvulkan1 mesa-vulkan-drivers \
        # FFmpeg bindings (feature `ffmpeg`)
        libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
        libavfilter-dev libavdevice-dev \
        # virtual X server for the UI tests
        xvfb xauth \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt

# Cargo output lives outside the bind-mounted source (a named volume in docker-compose), so the
# Windows / macOS host `target/` folder is never mixed with Linux artifacts.
ENV CARGO_TARGET_DIR=/target \
    CARGO_TERM_COLOR=always \
    LIBGL_ALWAYS_SOFTWARE=1 \
    WGPU_BACKEND=vulkan

COPY entrypoints/*.sh /usr/local/bin/
# Git on Windows may check the scripts out with CRLF line endings
RUN sed -i 's/\r$//' /usr/local/bin/*.sh && chmod +x /usr/local/bin/*.sh

WORKDIR /workspace
CMD ["/usr/local/bin/test-linux.sh"]
