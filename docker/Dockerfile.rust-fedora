# syntax=docker/dockerfile:1
# Neoveg - Fedora test image (same native libraries as Dockerfile.rust-linux, Rust through rustup).
# FFmpeg development packages come from RPM Fusion on Fedora; the default build and tests do not need them.
ARG FEDORA_IMAGE=fedora:latest
FROM ${FEDORA_IMAGE}
ENV NEOVEG_DISTRO=fedora

RUN dnf install -y --setopt=install_weak_deps=False         gcc gcc-c++ make pkgconf-pkg-config clang clang-devel python3 ca-certificates curl         alsa-lib-devel systemd-devel         mesa-libGL-devel libX11-devel libXcursor-devel libXrandr-devel libXi-devel libxkbcommon-devel         libxkbcommon-x11-devel wayland-devel vulkan-loader-devel vulkan-loader mesa-vulkan-drivers         xorg-x11-server-Xvfb xauth openssh-clients sshpass     && dnf clean all

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

RUN rustup component add clippy rustfmt

ENV CARGO_TARGET_DIR=/target \
    CARGO_TERM_COLOR=always \
    LIBGL_ALWAYS_SOFTWARE=1 \
    WGPU_BACKEND=vulkan

COPY entrypoints/*.sh /usr/local/bin/
RUN sed -i "s/\r$//" /usr/local/bin/*.sh && chmod +x /usr/local/bin/*.sh

WORKDIR /workspace
CMD ["/usr/local/bin/test-linux.sh"]
