# syntax=docker/dockerfile:1
#
# Neoveg - macOS cross-compilation image (osxcross + Rust). Produces Intel (x86_64-apple-darwin) and
# Apple Silicon (aarch64-apple-darwin) binaries from Linux. Tests cannot RUN here (Mach-O binaries do not
# execute on Linux); the image compiles the whole workspace, test binaries included.
#
# osxcross needs the macOS SDK, which Apple does not allow redistributing, so it is NOT part of this
# repository. Put the package in docker/sdk/ before building (see docker/sdk/README.md):
#
#   docker/sdk/MacOSX14.5.sdk.tar.xz
#   docker build -f docker/Dockerfile.rust-macos -t neoveg/rust-macos:local docker
ARG RUST_IMAGE=rust:latest
FROM ${RUST_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential pkg-config python3 ca-certificates git curl cmake patch make \
        clang lld llvm-dev libclang-dev libxml2-dev uuid-dev libssl-dev libbz2-dev zlib1g-dev \
        xz-utils bzip2 cpio \
    && rm -rf /var/lib/apt/lists/*

# Rust targets for both Mac architectures
RUN rustup component add clippy rustfmt \
    && rustup target add x86_64-apple-darwin aarch64-apple-darwin

# osxcross (pin OSXCROSS_REF to a commit for reproducible builds)
ARG OSXCROSS_REF=master
RUN git clone https://github.com/tpoechtrager/osxcross /opt/osxcross \
    && git -C /opt/osxcross checkout "${OSXCROSS_REF}"

COPY sdk/ /opt/osxcross/tarballs/
RUN ls /opt/osxcross/tarballs/MacOSX*.sdk.tar.* >/dev/null 2>&1 \
    || { echo "ERROR: no macOS SDK package found. Copy MacOSX<version>.sdk.tar.xz into docker/sdk/ (see docker/sdk/README.md)." >&2; exit 1; }
RUN cd /opt/osxcross && UNATTENDED=1 ./build.sh

ENV PATH=/opt/osxcross/target/bin:${PATH} \
    CARGO_TARGET_DIR=/target \
    CARGO_TERM_COLOR=always \
    MACOSX_DEPLOYMENT_TARGET=11.0

COPY entrypoints/*.sh /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/*.sh && chmod +x /usr/local/bin/*.sh

WORKDIR /workspace
CMD ["/usr/local/bin/build-macos.sh"]
