<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Neoveg.Controls"
             x:Class="Neoveg.Controls.ClipControl">
  <!--
    Neoveg Timeline Clip & Stereo Audio Waveform Control (ClipControl.axaml)
    Specified per Neoveg 10/11/12/13/18/21 Official Reference Manuals (AGENTS.md Section 10):
    1. Event Header (Generated Media, Event Pan/Crop, Video/Audio Event FX, Hamburger Menu ☰).
    2. Top-Left and Top-Right Fade In / Fade Out Corner Handles (PART_FadeInCornerHandle, PART_FadeOutCornerHandle).
    3. Opacity / Gain Envelope Line (PART_ClipOpacityGainLine).
    4. Audacity-style Multi-Zoom Stereo Waveform (Left & Right channels, 0 dB center axis, Peak + RMS).
  -->
  <Border x:Name="PART_ClipBorder"
          Background="#1e293b"
          BorderBrush="#38bdf8"
          BorderThickness="1"
          CornerRadius="2"
          ClipToBounds="True">
    <Grid RowDefinitions="19,*">
      <!-- Row 0: Neoveg Event Header + Top Corner Fade Handles -->
      <Border x:Name="PART_EventHeaderBar"
              Grid.Row="0"
              Background="#0f172a"
              Padding="4,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
          <!-- Top-Left Fade In Corner Handle -->
          <Border x:Name="PART_FadeInCornerHandle"
                  Grid.Column="0"
                  Width="8"
                  Height="8"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  Background="#facc15"
                  ToolTip.Tip="Alça de Fade In (Arraste para ajustar duração e curva de entrada)" />

          <TextBlock x:Name="PART_ClipTitle"
                     Grid.Column="1"
                     Text="Timeline Event"
                     Margin="4,0"
                     FontSize="10"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="#f8fafc" />

          <!-- Event Header Buttons: Generated Media, Event Pan/Crop, Event FX, Hamburger Menu (☰) -->
          <Button x:Name="PART_GeneratedMediaButton"
                  Grid.Column="2"
                  Content="⚙"
                  FontSize="9"
                  Padding="3,0"
                  ToolTip.Tip="Generated Media (Mídia Gerada)" />
          <Button x:Name="PART_EventPanCropButton"
                  Grid.Column="3"
                  Content="crops"
                  FontSize="9"
                  Padding="3,0"
                  ToolTip.Tip="Event Pan/Crop" />
          <Button x:Name="PART_EventFxButton"
                  Grid.Column="4"
                  Content="FX"
                  FontSize="9"
                  Padding="3,0"
                  ToolTip.Tip="Event FX (Media FX -> Take FX -> Event FX -> Track FX -> Master FX)" />
          <Button x:Name="PART_HamburgerMenuButton"
                  Grid.Column="5"
                  Content="☰"
                  FontSize="9"
                  Padding="3,0"
                  ToolTip.Tip="Event Hamburger Menu (☰)" />

          <!-- Top-Right Fade Out Corner Handle -->
          <Border x:Name="PART_FadeOutCornerHandle"
                  Grid.Column="6"
                  Width="8"
                  Height="8"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Background="#facc15"
                  ToolTip.Tip="Alça de Fade Out (Arraste para ajustar duração e curva de saída)" />
        </Grid>
      </Border>

      <!-- Row 1: Stereo Waveform + Opacity/Gain Envelope Line -->
      <Grid Grid.Row="1">
        <controls:AudioWaveformRenderer x:Name="PART_WaveformRenderer"
                                        IsHitTestVisible="False" />
        <Border x:Name="PART_ClipOpacityGainLine"
                Height="2"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Background="#38bdf8"
                ToolTip.Tip="Linha de Opacidade / Ganho (Opacity / Gain Envelope Line)" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
