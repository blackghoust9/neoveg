<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Neoveg.Controls"
             xmlns:vm="clr-namespace:Neoveg.ViewModels"
             x:Class="Neoveg.Controls.TrackHeaderControl"
             x:DataType="vm:TrackViewModelBase">
  <!--
    Neoveg Timeline Track Header Control (TrackHeaderControl.axaml)
    Specified per NLE Reference Architecture (AGENTS.md Section 10):
    1. 4px Left Vertical Accent Bar painted with TrackAccentColor.
    2. Track Number, Inline Track Name Editor, Track Motion, Track FX, Mute (M), Solo (S), and Track Height (+/-).
    3. Precision Volume / Opacity Slider and Stereo Pan Slider (Flat Thumb, Double-Click Reset, Ctrl 1/10 Fine Drag, Context Menu).
    4. Right-Click ContextMenu -> Cor da Faixa (Track Color) with curated dark-theme palette & Color Picker.
  -->
  <Border x:Name="PART_TrackHeaderBorder"
          Background="#18202c"
          BorderBrush="#263042"
          BorderThickness="0,0,1,1">
    <Border.ContextMenu>
      <ContextMenu x:Name="PART_TrackContextMenu">
        <MenuItem Header="Cor da Faixa... (Track Color)">
          <MenuItem Header="Azul Elétrico (#3498DB)" CommandParameter="#3498DB" />
          <MenuItem Header="Verde Esmeralda (#2ECC71)" CommandParameter="#2ECC71" />
          <MenuItem Header="Laranja (#E67E22)" CommandParameter="#E67E22" />
          <MenuItem Header="Roxo (#9B59B6)" CommandParameter="#9B59B6" />
          <MenuItem Header="Ciano (#1ABC9C)" CommandParameter="#1ABC9C" />
          <MenuItem Header="Vermelho Coral (#E74C3C)" CommandParameter="#E74C3C" />
          <MenuItem Header="Amarelo Ocre (#F1C40F)" CommandParameter="#F1C40F" />
          <Separator />
          <MenuItem x:Name="PART_OpenColorPickerMenuItem" Header="Seletor de Cor Personalizada (Color Picker)..." />
        </MenuItem>
      </ContextMenu>
    </Border.ContextMenu>

    <Grid ColumnDefinitions="4,*">
      <!-- 4px Left Vertical Track Accent Bar -->
      <Border x:Name="PART_TrackAccentBar"
              Grid.Column="0"
              Width="4"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Background="{Binding TrackAccentBrush}" />

      <!-- Track Header Controls Content -->
      <StackPanel Grid.Column="1" Margin="6,4" Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
          <!-- Track Number Box with Blinking White/Black Indicator Dot (#FFFFFF / #000000).
               The dot is shown (and blinks) only for the selected track (IsSelected == true). -->

          <Border x:Name="PART_TrackNumberBox"
                  Grid.Column="0"
                  Width="28"
                  Height="20"
                  Margin="0,0,5,0"
                  Background="#0f172a"
                  BorderBrush="#334155"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="3">
              <TextBlock Text="1"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="#f8fafc"
                         VerticalAlignment="Center" />
              <Ellipse x:Name="PART_TrackBlinkDot"
                       IsVisible="{Binding IsSelected}"
                       Width="6"
                       Height="6"
                       Fill="#FFFFFF"
                       Stroke="#000000"
                       StrokeThickness="0.8"
                       VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding TrackName}"
                     Grid.Column="1"
                     FontSize="11"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="#f8fafc" />
          <Button x:Name="PART_TrackMotionButton" Grid.Column="2" Content="✥" FontSize="10" Padding="4,1" ToolTip.Tip="Track Motion" />
          <Button x:Name="PART_TrackFxButton" Grid.Column="3" Content="ƒ" FontSize="10" Padding="4,1" ToolTip.Tip="Track FX" />
          <Button x:Name="PART_MuteButton" Grid.Column="4" Content="⊘" FontSize="10" Padding="4,1" ToolTip.Tip="Mute Track" />
          <Button x:Name="PART_SoloButton" Grid.Column="5" Content="◉" FontSize="10" Padding="4,1" ToolTip.Tip="Solo Track" />
        </Grid>

        <!-- Volume / Level and Pan Sliders -->
        <Grid ColumnDefinitions="Auto,*,Auto,*">
          <TextBlock Grid.Column="0" Text="Vol:" FontSize="9" Foreground="#94a3b8" VerticalAlignment="Center" Margin="0,0,4,0" />
          <controls:NeovegPrecisionSlider x:Name="PART_TrackVolumeSlider" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="1.0" DefaultValue="1.0" />
          <TextBlock Grid.Column="2" Text="Pan:" FontSize="9" Foreground="#94a3b8" VerticalAlignment="Center" Margin="6,0,4,0" />
          <controls:NeovegPrecisionSlider x:Name="PART_TrackPanSlider" Grid.Column="3" Minimum="-1.0" Maximum="1.0" Value="0.0" DefaultValue="0.0" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
