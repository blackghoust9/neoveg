<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Neoveg Missing Media Modal Window Layout & Localization Tokens (MissingMediaWindow.axaml) -->
  <sys:String x:Key="MissingMedia.WindowTitle">Neoveg / Neoveg — Janela de Mídias Ausentes (Missing Media)</sys:String>
  <sys:String x:Key="MissingMedia.HeaderBanner">Um ou mais arquivos de mídia do MediaPool não foram encontrados no caminho original.</sys:String>
  <sys:String x:Key="MissingMedia.Col.FileName">Nome do Arquivo</sys:String>
  <sys:String x:Key="MissingMedia.Col.OriginalPath">Caminho Original</sys:String>
  <sys:String x:Key="MissingMedia.Col.Duration">Duração Esperada</sys:String>
  <sys:String x:Key="MissingMedia.Col.MediaType">Tipo de Mídia (Vídeo/Áudio)</sys:String>
  <sys:String x:Key="MissingMedia.Action.SearchDirectory">Procurar em uma Pasta... (Search Directory)</sys:String>
  <sys:String x:Key="MissingMedia.Action.SpecifyLocation">Substituir Arquivo Especificamente... (Specify New Location)</sys:String>
  <sys:String x:Key="MissingMedia.Action.IgnoreOne">Ignorar Este Arquivo (Ignore)</sys:String>
  <sys:String x:Key="MissingMedia.Action.IgnoreAll">Ignorar Todos Ausentes (Ignore All)</sys:String>
</ResourceDictionary>
