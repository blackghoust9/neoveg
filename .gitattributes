# ============================================================================
# Neoveg — Standardized Cross-Platform Line Endings (.gitattributes)
# Prevents "LF will be replaced by CRLF" warnings in Git & GitHub Desktop
# across Windows, Linux, and macOS.
# ============================================================================

# Default: auto-detect text files and keep LF line endings across all OSes
* text=auto eol=lf

# Source Code & Configuration (Strictly LF)
*.cs     text eol=lf
*.csproj text eol=lf
*.axaml  text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.cpp    text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.fcpxml text eol=lf
*.edl    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.qss    text eol=lf
*.rc     text eol=lf
*.cube   text eol=lf
Dockerfile      text eol=lf
CMakeLists.txt  text eol=lf

# Windows Batch, PowerShell & Visual Studio Solution Files (Strictly CRLF)
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.sln    text eol=crlf

# Binary & Media Assets (Never modify bytes)
*.dll    binary
*.exe    binary
*.so     binary
*.dylib  binary
*.pdb    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.mp4    binary
*.mov    binary
*.mkv    binary
*.wav    binary
*.sfk    binary
*.neoveg binary
*.zip    binary
*.gz     binary
*.tar    binary
