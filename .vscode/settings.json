{
  "cmake.sourceDirectory": "${workspaceFolder}/cpp-extensions",
  "cmake.buildDirectory": "${workspaceFolder}/cpp-extensions/build",
  "cmake.enableAutomaticKitScan": true,
  "cmake.configureOnOpen": true,
  "cmake.exportCompileCommandsFile": true,
  "cmake.ParallelJobs": 4,
  "dotnet.defaultSolution": "Neoveg.sln",
  "omnisharp.projectLoadTimeout": 60,
  "files.exclude": {
    "**/backup_v1_anterior/**": true
  },
  "search.exclude": {
    "**/backup_v1_anterior/**": true
  },
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/cpp-extensions/include"
  ],
  "C_Cpp.default.defines": [
    "NEOVEG_CPP_EXPORTS"
  ]
}
