    {"id": "titulo", "type": "text", "text": "# Layout padrão do dock (egui_dock)\nReflete `default_dock()` em `neoveg_ui/src/app.rs`. Proporções: Timeline embaixo (48%), Mídia à esquerda (28%), Master à direita (18%).", "x": 0, "y": -170, "width": 1600, "height": 130, "color": "5"},
